{
  "name": "levanto",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript client for the Levanto Sage decision API.",
  "homepage": "https://docs.levanto.ai",
  "author": "Levanto Labs <team@levanto.ai>",
  "repository": { "type": "git", "url": "git+https://github.com/levantolabs/levanto-js.git" },
  "bugs": { "url": "https://github.com/levantolabs/levanto-js/issues", "email": "team@levanto.ai" },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "levanto",
    "sage",
    "llm",
    "decision",
    "classifier"
  ],
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}

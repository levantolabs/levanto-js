{
  "name": "levanto",
  "version": "1.1.0",
  "description": "TypeScript/JavaScript client for the Levanto Sage decision API (v1.1).",
  "homepage": "https://docs.levanto.ai",
  "author": "Levanto Labs <team@levanto.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levantolabs/levanto-js.git"
  },
  "bugs": {
    "url": "https://github.com/levantolabs/levanto-js/issues",
    "email": "team@levanto.ai"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "levanto",
    "sage",
    "llm",
    "decision",
    "classifier",
    "ai-agents"
  ],
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "^8.17.1",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
